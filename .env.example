# Copy to .env.local and fill in. See CLAUDE.md → Environment Variables.

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Auth redirects and absolute URLs. Falls back to VERCEL_URL on Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Yoco — server only. Never prefix with NEXT_PUBLIC_.
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
# Optional: webhook replay window in seconds (default 180).
# YOCO_WEBHOOK_TOLERANCE_SECONDS=180
